# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://filmroom:filmroom@localhost:5432/filmroom
SYNC_DATABASE_URL=postgresql://filmroom:filmroom@localhost:5432/filmroom
POSTGRES_USER=filmroom
POSTGRES_PASSWORD=filmroom
POSTGRES_DB=filmroom

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── OpenAI (for embeddings + LangChain LLM) ───────────────────────────────────
OPENAI_API_KEY=sk-...

# ── LangSmith (optional but recommended) ─────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-film-room

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DATA_DIR=./data
MAX_VIDEO_SIZE_MB=500
FRAME_SAMPLE_RATE=3
EVENT_CONFIDENCE_THRESHOLD=0.65
YOLO_MODEL=yolov8n.pt
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
